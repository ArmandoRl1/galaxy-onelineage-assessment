+    /**
+     * Samsung's SEPF policy does not define the "ksu_file" type, so ksud's
+     * installer dies at "Failed to change SELinux context for /data/adb/ksud"
+     * (lsetxattr returns EINVAL for an undefined type) and the daemon never
+     * starts. Relabel to a type that exists in this policy, same byte length,
+     * so the installer completes. Both contexts are 22 bytes ASCII.
+     */
+    private static void patchKsudLabels(File ksud) throws Exception {
+        final byte[] from = "u:object_r:ksu_file:s0".getBytes("UTF-8");
+        final byte[] to   = "u:object_r:installd:s0".getBytes("UTF-8");
+        byte[] data = Files.readAllBytes(ksud.toPath());
+        int replaced = 0;
+        for (int i = 0; i + from.length <= data.length; i++) {
+            boolean hit = true;
+            for (int j = 0; j < from.length; j++) {
+                if (data[i + j] != from[j]) { hit = false; break; }
+            }
+            if (hit) {
+                System.arraycopy(to, 0, data, i, to.length);
+                replaced++;
+                i += to.length - 1;
+            }
+        }
+        if (replaced > 0) {
+            Files.write(ksud.toPath(), data);
+        }
+    }
+
